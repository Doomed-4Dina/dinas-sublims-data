{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Doomed-4Dina/dinas-sublims-data/blob/main/schemas/images.schema.json",
  "title": "Image URL data",
  "type": "object",
  "additionalProperties": false,
  "required": ["images"],
  "properties": {
    "images": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "uri",
        "pattern": "^https?://"
      }
    }
  }
}
